# Copy to .dev.vars for `bun run dev`. Generate the secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://127.0.0.1:3100
# Extra origins allowed to call /api/auth (tailnet, previews), comma-separated.
BETTER_AUTH_TRUSTED_ORIGINS=http://127.0.0.1:3100,http://localhost:3100
# Turnstile site key (round 18, Q16), public. Optional in development: Cloudflare's always-pass test key
# is used when unset. The secret key lives in the vault (apps/vault/.dev.vars), which checks the token.
TURNSTILE_SITE_KEY=
# Passkeys are bound to a domain, never an IP: in development use the tailnet host and its HTTPS origin.
PASSKEY_RP_ID=
PASSKEY_ORIGINS=
# Supabase Postgres (São Paulo), the session pooler string from Connect in the dashboard. Server-side only.
# Start with the `postgres` string in DATABASE_URL; `bun run db:roles` (after `bun run db:migrate`) moves it
# to DATABASE_ADMIN_URL and gives the app its own role, fala_app, which can't read the vault's schema.
DATABASE_URL=
DATABASE_ADMIN_URL=
# The open-data API's role, fala_dados (written by `bun run db:roles`): it reads only the `dados` views.
# Not used by the app; apps/dados reads it from here in development.
DADOS_DATABASE_URL=
# The vault's public key, written by `bun run vault:keys`. Not secret: it verifies, it can't sign.
VAULT_VERIFY_KEY=
# Supabase API, server-side only (Storage). The secret key never reaches the browser.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Web push (VAPID, RFC 8292): `bun run push:keys` writes both. VAPID_PRIVATE_KEY is a JWK; the public
# key is the raw point, base64url, which browsers subscribe with.
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=

# Screening service (apps/triagem; DECISIONS round 20): `bun --filter @fala/triagem models`, then `dev`.
# Empty: photos aren't screened, and moderators still look at every one. Production also sets
# TRIAGEM_TOKEN, the same value as the service's.
TRIAGEM_URL=
TRIAGEM_TOKEN=
# Known abuse material (BUILD 5.8): new photos stay out of every moderator's sight until the service
# has compared their fingerprint with Arachnid Shield (the service needs ARACHNID_SHIELD_USERNAME and
# ARACHNID_SHIELD_PASSWORD). required|off; unset, production requires it and development doesn't.
HASH_MATCHING=
