{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "falacanoas-web",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  // src/server.ts: TanStack Start's request handler plus the daily job.
  "main": "src/server.ts",
  "observability": { "enabled": true },
  // The identity vault (apps/vault), the only way the app reaches it; and the share-card renderer
  // (apps/cards), which draws what the app describes.
  "services": [
    { "binding": "VAULT", "service": "falacanoas-vault" },
    { "binding": "CARDS", "service": "falacanoas-cards" }
  ],
  // Daily at 03:05 in Canoas (06:05 UTC): pins closed by 15 days without dispute; every 10 minutes:
  // photos still waiting for the known-material check, screened again (src/server.ts).
  "triggers": { "crons": ["5 6 * * *", "*/10 * * * *"] }
}
