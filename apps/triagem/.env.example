# Photo screening (apps/triagem). Run `bun --filter @fala/triagem models` once before the first start.
# "production" refuses to start without TRIAGEM_TOKEN.
TRIAGEM_MODE=
# The token the app sends (32+ characters; the same value as the app's TRIAGEM_TOKEN).
TRIAGEM_TOKEN=
# The Arachnid Shield account (issued by C3P). Without it, nothing is checked against known abuse
# material, and an app that requires the check keeps new photos out of sight.
ARACHNID_SHIELD_USERNAME=
ARACHNID_SHIELD_PASSWORD=
ARACHNID_SHIELD_URL=
# ONNX Runtime and sharp threads: set it to the container's vCPUs. Unset, ONNX opens one per host core.
TRIAGEM_THREADS=
# 127.0.0.1 by default; a container sets 0.0.0.0 behind its own TLS proxy.
HOST=
PORT=3500
