# The WhatsApp service (apps/whatsapp). Development needs none of these: it reads the web app's and
# the vault's .dev.vars and writes replies to outbox/.
# "production" answers 501 until a provider is plugged in.
WHATSAPP_MODE=
WHATSAPP_DATABASE_URL=
# The instance's site, and the two tokens for registering by WhatsApp (32+ characters each, the same
# values as the vault's WHATSAPP_VAULT_TOKEN and the app's WHATSAPP_APP_TOKEN).
WHATSAPP_SITE_URL=
WHATSAPP_VAULT_TOKEN=
WHATSAPP_APP_TOKEN=
WHATSAPP_OUTBOX=
PORT=3300
