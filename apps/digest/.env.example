# The digest service (apps/digest). Development needs none of these: it reads the web app's
# apps/web/.dev.vars, writes e-mails to outbox/ and never schedules itself.
# "production" turns the schedule on and refuses to send until a sender is configured.
DIGEST_MODE=
# A session connection (port 5432), as fala_app: the transaction pooler (6543) is refused.
DIGEST_DATABASE_URL=
# The sender and the addressees (comma-separated).
DIGEST_FROM=
DIGEST_TO=
DIGEST_CC=
# Bearer token for POST /resumo and POST /mensal; without one, those routes are closed.
DIGEST_TOKEN=
# Bearer token for POST /respostas (the inbound e-mail relay); without one, the route is closed.
DIGEST_REPLIES_TOKEN=
# The receiving server's name in Authentication-Results: replies are applied on their own only when
# it vouches for a Prefeitura address.
DIGEST_AUTHSERV=
# Where photos are fetched from (the site itself in production), and where things are kept.
DIGEST_PHOTO_BASE=
DIGEST_OUTBOX=
DIGEST_CACHE=
# Development: 1 archives the rain gauges every 10 minutes too.
DIGEST_RAIN=
DIGEST_HOST=
PORT=3200
