{
  "name": "fala",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.0",
  "description": "Fala Core e a inst\u00e2ncia Fala, Canoas: mapa c\u00edvico independente e de c\u00f3digo aberto.",
  "license": "AGPL-3.0-only",
  "scripts": {
    "dev": "bun --filter @fala/web dev",
    "build": "bun --filter @fala/web build",
    "preview": "bun --filter @fala/web preview",
    "deploy": "bun --filter @fala/web deploy",
    "test": "bun test",
    "typecheck": "bun --filter '*' typecheck",
    "lint": "oxlint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "db:generate": "bun --filter @fala/web db:generate",
    "db:migrate": "bun --filter @fala/web db:migrate && bun --filter @fala/vault db:migrate",
    "db:seed": "bun --filter @fala/web db:seed",
    "db:roles": "bun --filter @fala/web db:roles",
    "vault:keys": "bun --filter @fala/vault keys",
    "push:keys": "bun apps/web/scripts/push-keys.ts"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "instances/*"
  ],
  "trustedDependencies": [
    "esbuild",
    "workerd",
    "sharp"
  ],
  "devDependencies": {
    "@shadcn/lint": "^0.2.1",
    "oxlint": "^1.83.0",
    "prettier": "^3.9.10",
    "typescript": "7.0.2"
  }
}
